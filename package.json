{
  "name": "route-map-studio",
  "version": "0.1.0",
  "private": true,
  "description": "本地路线地图视频工作台：选点、选风格、实时预览、一键渲染竖屏路线动画",
  "type": "module",
  "scripts": {
    "start": "tsx server/index.ts",
    "postinstall": "node scripts/copy-worker.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "studio": "remotion studio src/video/index.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@remotion/compositor-darwin-arm64"
    ]
  },
  "dependencies": {
    "@remotion/bundler": "4.0.245",
    "@remotion/cli": "4.0.245",
    "@remotion/player": "4.0.245",
    "@remotion/renderer": "4.0.245",
    "@turf/turf": "7.4.0",
    "express": "^4.22.3",
    "maplibre-gl": "6.18.0",
    "pinyin-pro": "^3.29.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.245"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.68.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  }
}
