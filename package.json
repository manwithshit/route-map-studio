{
  "name": "route-map-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "本地路线地图视频工作台：选点、12 套风格、3 种画幅、实时预览与本地一键渲染 3D 路线动画",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "start": "tsx server/index.ts",
    "postinstall": "node scripts/copy-worker.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "studio": "remotion studio src/video/index.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@remotion/compositor-darwin-arm64"
    ],
    "overrides": {
      "ws": ">=8.21.0",
      "webpack": ">=5.104.1",
      "esbuild": ">=0.25.0"
    }
  },
  "dependencies": {
    "@remotion/bundler": "4.0.547",
    "@remotion/cli": "4.0.547",
    "@remotion/player": "4.0.547",
    "@remotion/renderer": "4.0.547",
    "@turf/turf": "7.4.0",
    "express": "^4.22.3",
    "maplibre-gl": "6.18.0",
    "pinyin-pro": "^3.29.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.547",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.68.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.7",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  }
}
